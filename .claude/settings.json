{
  "permissions": {
    "allow": [
      "Bash(./gradlew:*)",
      "Bash(curl:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Edit(user.txt)",
      "Write(user.txt)",
      "Bash(git push --force:*)",
      "Bash(git add -f:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/test-gate.sh", "timeout": 300 }
        ]
      }
    ]
  }
}
